{
  "schemaVersion": 1,
  "id": "gpt-image-2",
  "vendor": "openai",
  "mediaType": "image",
  "operations": [
    {
      "id": "text-to-image",
      "modelName": "gpt-image-2",
      "requiredFields": ["prompt", "width", "height", "resolution", "quality"],
      "optionalFields": [],
      "prohibitedFields": ["image_url_list"],
      "fields": {
        "prompt": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "resolution": { "type": "string", "values": ["1k", "2k", "4k"] },
        "quality": { "type": "string", "values": ["low", "medium", "high"] }
      },
      "constraints": {
        "allowedPairs": [
          {
            "fields": ["width", "height"],
            "values": [[16, 9], [9, 16], [1, 1], [3, 2], [2, 3], [3, 4], [4, 3], [5, 4], [4, 5], [21, 9]]
          }
        ]
      }
    },
    {
      "id": "image-to-image",
      "modelName": "gpt-image-2-edit",
      "requiredFields": ["prompt", "image_url_list"],
      "optionalFields": ["width", "height", "resolution", "quality"],
      "prohibitedFields": [],
      "fields": {
        "prompt": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "image_url_list": { "type": "string-array", "format": "media-input", "minItems": 1, "maxItems": 16 },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "resolution": { "type": "string", "values": ["1k", "2k", "4k"], "default": "1k" },
        "quality": { "type": "string", "values": ["low", "medium", "high"], "default": "medium" }
      },
      "constraints": {
        "allOrNone": [["width", "height"]],
        "allowedPairs": [
          {
            "fields": ["width", "height"],
            "values": [[16, 9], [9, 16], [1, 1], [3, 2], [2, 3], [3, 4], [4, 3], [5, 4], [4, 5], [21, 9]]
          }
        ]
      }
    }
  ]
}
